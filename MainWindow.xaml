<Window x:Class="PdfRgeBizsReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdfRgeBizsReader"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid x:Name="BizsGrid" Visibility="Collapsed">
                    <ItemsControl x:Name="BizsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Black" BorderThickness="2" Background="WhiteSmoke" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="32" Margin="5" Text="{Binding Name}" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="18" Text="Nom :" Margin="100,2,2,2"/>
                                            <TextBlock FontSize="18" Text="{Binding Name}" Margin="2"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="18" Text="Adresse :" Margin="100,2,2,2"/>
                                            <TextBlock FontSize="18" Text="{Binding Adress}" Margin="2"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="18" Text="Ville :" Margin="100,2,2,2"/>
                                            <TextBlock FontSize="18" Text="{Binding City}" Margin="2"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="18" Text="Secteurs :" Margin="100,2,2,2"/>
                                            <TextBlock FontSize="18" Text="{Binding FormatedSectors}" Margin="2"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="18" Text="Email :" Margin="100,2,2,2"/>
                                            <TextBlock FontSize="18" Text="{Binding Email}" Margin="2"/>
                                        </StackPanel>
                                        <Button Content=" Détail" Margin="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="200" Click="BizDetailButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Grid x:Name="SelectPdfGrid" Visibility="Visible">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Sélectionnez un PDF"/>
                        <Button Content="Ouvrir" Margin="5" Height="35" Click="SelectPdfButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
